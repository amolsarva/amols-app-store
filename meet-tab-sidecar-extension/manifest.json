{
  "manifest_version": 3,
  "name": "Meet Tab Sidecar",
  "version": "1.0.0",
  "description": "Open a Google Meet tab and a controlled sidecar tab for recordings, scripted intros, checklists, and tab-sharing handoffs.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "action": {
    "default_title": "Meet Tab Sidecar",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "css": [
        "meet-content.css"
      ],
      "js": [
        "meet-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "welcome.html"
}
